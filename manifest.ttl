@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<http://github.com/geraldmwangi/GuitarMidi-LV2> a lv2:Plugin .
<http://github.com/geraldmwangi/GuitarMidi-LV2>	lv2:binary <guitarmidi.so> .
<http://github.com/geraldmwangi/GuitarMidi-LV2>	rdfs:seeAlso <guitarmidi.ttl> .

<http://github.com/geraldmwangi/GuitarMidi-LV2#ui> a ui:X11UI .
<http://github.com/geraldmwangi/GuitarMidi-LV2#ui> ui:binary <guitarmidi_ui.so> .
<http://github.com/geraldmwangi/GuitarMidi-LV2#ui> rdfs:seeAlso <guitarmidi.ttl> .
